<xsl:stylesheet
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:fo="http://www.w3.org/1999/XSL/Format"
  version="2.0"
>

  <!-- PrismJS code block styling aligned with Darkly variables -->
  <xsl:variable name="prismjs.text.color">#212529</xsl:variable>
  <xsl:variable name="prismjs.comment.color">#6c757d</xsl:variable>
  <xsl:variable name="prismjs.punctuation.color">#6c757d</xsl:variable>
  <xsl:variable name="prismjs.namespace.color">#6c757d</xsl:variable>
  <xsl:variable name="prismjs.tag.color">#993685</xsl:variable>
  <xsl:variable name="prismjs.string.color">#008261</xsl:variable>
  <xsl:variable name="prismjs.keyword.color">#375a7f</xsl:variable>
  <xsl:variable name="prismjs.type.color">#cb4335</xsl:variable>
  <xsl:variable name="prismjs.regex.color">#9e650c</xsl:variable>
  <xsl:variable name="prismjs.deleted.color">#cb4335</xsl:variable>
  <xsl:variable name="prismjs.url.color">#7a4d09</xsl:variable>

  <xsl:variable name="prismjs.background.color">#f8f9fa</xsl:variable>
  <xsl:variable name="prismjs.border.color">#dee2e6</xsl:variable>
  <xsl:variable name="prismjs.card.background.color">#f8f9fa</xsl:variable>
  <xsl:variable name="prismjs.font-weight">normal</xsl:variable>

</xsl:stylesheet>
